# ===================================================
# Harni 伺服器設定檔 (Server Configuration)
# ===================================================
# 注意：所有 LLM 模型 API 金鑰（如 Anthropic、OpenAI、
# Google Antigravity、DeepSeek、Ollama 等）皆可直接在
# 網頁介面「偏好設定 (Settings)」中配置，由後端使用 
# AES-256-GCM 密碼學加密儲存於 SQLite 資料庫中，
# 無需在此處填寫任何 LLM API 金鑰。
# ===================================================

# 1. 伺服器監聽連接埠與位址 (預設僅監聽 127.0.0.1 本機以確保安全)
PORT=3001
HOST=127.0.0.1

# 2. 伺服器存取安全權杖 (Auth Token)
# 預設監聽 127.0.0.1 時無需設定。
# 若需對外網或區域網路開放 (HOST=0.0.0.0)，系統強制要求配置 AUTH_TOKEN 以防止未授權遠端指令執行 (RCE)：
# AUTH_TOKEN=your_secure_auth_token_here

# 3. 不安全遠端存取覆寫 (僅限隔離測試環境，預設 false)
# ALLOW_INSECURE_REMOTE_ACCESS=false

# 4. Agent 操作之專案工作區根目錄 (可選，預設為本機專案目錄)
# WORKSPACE_ROOT=.

# 5. SQLite 資料庫儲存路徑 (可選，預設儲存於 ~/.harni/harni.db)
# HARNI_DB_PATH=./harni.db
